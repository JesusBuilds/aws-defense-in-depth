#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

# 1 GB swap so Prometheus + Grafana fit on a 1 GB instance
fallocate -l 1G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile

dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/monitoring/grafana/provisioning/datasources
cd /opt/monitoring

# Secret comes from SSM Parameter Store via the instance role, never from user_data
PW=$(aws ssm get-parameter --name "${secret_name}" --with-decryption --query Parameter.Value --output text --region ${region})
echo "GF_SECURITY_ADMIN_PASSWORD=$PW" > grafana.env
chmod 600 grafana.env

cat > prometheus.yml <<'EOF'
global:
  scrape_interval: 15s
rule_files:
  - /etc/prometheus/alerts.yml
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']
  - job_name: node
    static_configs:
      - targets: ['${web_ip}:9100']
        labels:
          host: web
  - job_name: blackbox-web
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ['http://${web_ip}']
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
EOF

cat > alerts.yml <<'EOF'
groups:
  - name: lab-alerts
    rules:
      - alert: WebHostDown
        expr: up{job="node"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "node_exporter on {{ $labels.instance }} is down"
      - alert: WebEndpointDown
        expr: probe_success{job="blackbox-web"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "HTTP probe failing for {{ $labels.instance }}"
      - alert: HighCPU
        expr: 100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[2m])) * 100) > 80
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "CPU above 80% on {{ $labels.instance }}"
EOF

cat > grafana/provisioning/datasources/prometheus.yml <<'EOF'
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
EOF

cat > docker-compose.yml <<'EOF'
services:
  prometheus:
    image: prom/prometheus:latest
    restart: always
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./alerts.yml:/etc/prometheus/alerts.yml:ro
    ports:
      - "9090:9090"
  blackbox:
    image: prom/blackbox-exporter:latest
    restart: always
  grafana:
    image: grafana/grafana:latest
    restart: always
    env_file:
      - grafana.env
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
    ports:
      - "3000:3000"
EOF

docker compose up -d
